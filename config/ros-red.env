# Red ROS 2 del robot. La leen systemd/wallens.service (EnvironmentFile) y scripts/ros-env.sh (shells de la Pi).
# Dominio propio: otros grupos del laboratorio (dominio 0 por defecto) no ven ni mandan nada al robot.
ROS_DOMAIN_ID=37
# Solo se descubren nodos de la propia Pi; el PC entra solo si su IP está en ROS_STATIC_PEERS
# (~/.config/wallens/peers.env en la Pi, fuera del repo porque la IP cambia). Ver docs/sistema.md, "Red".
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
