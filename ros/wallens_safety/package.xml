<?xml version="1.0"?>
<package format="3">
  <name>wallens_safety</name>
  <version>0.1.0</version>
  <description>Freno por obstáculo con el LiDAR: filtra /cmd_vel antes de que llegue al driver de las ruedas</description>
  <maintainer email="sebasgrajalesp28@gmail.com">sebas</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>procps</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
